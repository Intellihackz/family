# Railway sets PORT itself. Everything else is optional for local dev.
PORT=8787

# Robinhood Chain RPC. The public endpoint is rate limited; use a provider key in production.
RPC_URL=https://rpc.mainnet.chain.robinhood.com

# Enables DELETE /rooms/:token/messages/:id (moderator removal). Leave unset to disable.
ADMIN_KEY=

# Where chat history is stored. On Railway, mount a volume at /data and set this to /data.
DATA_DIR=data

# Launchpad API used to find each token's dev and bonding curve.
PONS_API=https://ponsfamily.com
