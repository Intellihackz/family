{
  "name": "family",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "watch": "node build.mjs --watch",
    "typecheck": "tsc --noEmit",
    "icons": "node scripts/icons.mjs",
    "brand": "node scripts/brand.mjs",
    "pack": "FAMILY_API=${FAMILY_API:-https://family-production-e140.up.railway.app} npm run build && rm -f landing/family-alpha.zip && (cd dist && zip -qr ../landing/family-alpha.zip . -x \"*.map\")"
  },
  "devDependencies": {
    "@fontsource/nunito": "^5.3.0",
    "@resvg/resvg-js": "^2.6.2",
    "@types/chrome": "^0.0.290",
    "esbuild": "^0.24.0",
    "opentype.js": "^2.0.0",
    "typescript": "^5.6.0"
  }
}
